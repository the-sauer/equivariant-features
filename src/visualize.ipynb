    "            torch.arange(img.size(2), device=torch.device(\"cuda\")), indexing=\"ij\"\n",
    "        ), dim=-1).unsqueeze(0).float()\n",
    "        out = model(img.unsqueeze(0).cuda()).permute(0, 3, 4, 1, 2)\n",
    "        detections = homogenize(out, b)\n",
